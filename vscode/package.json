{
  "name": "coco-agent",
  "displayName": "CoCo Agent",
  "description": "Native CoCo tasks, context, diff review, approvals and history for VS Code",
  "version": "0.8.0",
  "publisher": "bit-cook",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:coco.createTask",
    "onCommand:coco.showTasks",
    "onCommand:coco.openControl"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "coco.createTask",
        "title": "Create Background Task"
      },
      {
        "command": "coco.showTasks",
        "title": "Show Task History"
      },
      {
        "command": "coco.openControl",
        "title": "Open Control Dashboard"
      },
      {
        "command": "coco.diffActive",
        "title": "Compare Active File with Git"
      }
    ],
    "configuration": {
      "title": "CoCo",
      "properties": {
        "coco.controlUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3210",
          "description": "CoCo local control URL"
        }
      }
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "license": "MIT"
}
